# Runtime
NODE_ENV=development
PORT=4000

# MongoDB — somente a API acessa o banco
MONGODB_URI=
MONGODB_DB_NAME=KZTechSite

# CORS — deixe vazio quando frontend e API estiverem no mesmo domínio
CORS_ORIGINS=http://localhost:4000

# Public canonical URL
PUBLIC_SITE_URL=http://localhost:4000

# Frontend can override the API origin with window.KZ_API_BASE or meta[name="api-base"].
# Example for a separate static host: https://api.example.com
